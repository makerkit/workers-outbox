{
  "name": "outbox-example",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // node-postgres needs the Node.js compatibility layer.
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    { "binding": "DB", "id": "<app hyperdrive id>" },
    // Same database, a separate config with caching disabled.
    { "binding": "OUTBOX_DB", "id": "<outbox hyperdrive id>" },
  ],
  "queues": {
    "producers": [{ "binding": "OUTBOX_QUEUE", "queue": "outbox" }],
    "consumers": [
      { "queue": "outbox", "dead_letter_queue": "outbox-dlq", "max_retries": 10 },
      { "queue": "outbox-dlq" },
    ],
  },
  // The durable backstop: recovery, sweeps and cleanup.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Gates newer jobs from older deploys during a gradual rollout.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
}
