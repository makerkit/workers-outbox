{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "sortImports": {
    "groups": [
      "type-import",
      ["value-builtin", "value-external"],
      "type-internal",
      "value-internal",
      ["type-parent", "type-sibling", "type-index"],
      ["value-parent", "value-sibling", "value-index"],
      "unknown"
    ],
    "ignoreCase": true,
    "newlinesBetween": true,
    "order": "asc"
  },
  "singleQuote": true,
  "printWidth": 100,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "ignorePatterns": ["package.json", "node_modules", "dist", "pnpm-lock.yaml"]
}
